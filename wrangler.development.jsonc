{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "techedge-nexus-dev",
	"main": "dist/nexus_crm_backoffice_pypnqia6hgu5p15avjc7a/index.js",
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": [
				"**/*.js",
				"user-routes"
			]
		}
	],
	"compatibility_date": "2025-04-24",
	"routes": [
		{
			"pattern": "dev-dashboard.the-pot.nl",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"!/api/docs/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "GlobalDurableObject",
				"class_name": "GlobalDurableObject"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "THEPOT_DB",
			"database_name": "thepot-development-db",
			"database_id": "c74ad2d8-ff52-4a4f-9f7b-9c1a8553617f"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GlobalDurableObject"
			]
		}
	]
}