{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "techedge-nexus-dev",
	"main": "dist/nexus_crm_backoffice_pypnqia6hgu5p15avjc7a/index.js",
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": [
				"**/*.js",
				"user-routes"
			]
		}
	],
	"compatibility_date": "2025-04-24",
	"routes": [
		{
			"pattern": "dev-dashboard.the-pot.nl",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"!/api/docs/*"
		]
	},
	"observability": {
		"enabled": true
	},
	// ─── Cloudflare Zero Trust / Auth configuration ──────────────────────────
	// Set CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD in the Cloudflare dashboard
	// under Workers → Settings → Variables & Secrets (use Secrets for production).
	// CF_ACCESS_TEAM_DOMAIN  : e.g. "yourteam.cloudflareaccess.com"
	// CF_ACCESS_AUD          : Application AUD from Access > Applications > your app
	// RESEND_API_KEY         : API key from https://resend.com for alert emails
	// ALERT_EMAIL            : Recipient for security alerts (default: info@kas040.nl)
	// GOOGLE_CLIENT_SECRET   : Set as a Worker Secret (never as a plain var):
	//   npx wrangler secret put GOOGLE_CLIENT_SECRET --config wrangler.development.jsonc
	"vars": {
		"CF_ACCESS_TEAM_DOMAIN": "",
		"CF_ACCESS_AUD": "",
		"ALERT_EMAIL": "info@kas040.nl",
		// Google OAuth 2.0 — Web Client
		// Aanmaken via: https://console.cloud.google.com/apis/credentials
		// Vul GOOGLE_CLIENT_ID in; stel GOOGLE_CLIENT_SECRET in als Worker Secret (zie boven)
		"GOOGLE_CLIENT_ID": "",
		"GOOGLE_REDIRECT_URI": "https://dev-dashboard.the-pot.nl/api/auth/google/callback"
	},
	// NOTE: Set RESEND_API_KEY as a Worker Secret (never as a plain var):
	//   npx wrangler secret put RESEND_API_KEY --config wrangler.development.jsonc
	"durable_objects": {
		"bindings": [
			{
				"name": "GlobalDurableObject",
				"class_name": "GlobalDurableObject"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "THEPOT_DB",
			"database_name": "thepot-development-db",
			"database_id": "c74ad2d8-ff52-4a4f-9f7b-9c1a8553617f"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GlobalDurableObject"
			]
		}
	]
}