# ─── Google OAuth 2.0 — Web Client ────────────────────────────────────────────
# Aanmaken via: https://console.cloud.google.com/apis/credentials
# Kies "OAuth 2.0 Client IDs" → "Web application"
#
# Let op: VITE_* variabelen worden ingebakken in de frontend build.
#         Zet geheimen (client_secret) NOOIT als VITE_* variabele.

# Google Client ID (veilig — alleen publiek identificator)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Redirect URI — moet exact overeenkomen met "Authorized redirect URIs" in Google Console
# Lokaal:      http://localhost:3000/api/auth/google/callback
# Development: https://dev-dashboard.the-pot.nl/api/auth/google/callback
# Production:  https://dashboard.the-pot.nl/api/auth/google/callback
VITE_GOOGLE_REDIRECT_URI=https://dev-dashboard.the-pot.nl/api/auth/google/callback

# ─── Worker-side secrets (nooit VITE_ prefix — niet zichtbaar in frontend) ───
# Stel in via: wrangler.development.jsonc → vars  (of als Worker Secret voor productie)
#
# GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=https://dev-dashboard.the-pot.nl/api/auth/google/callback

# ─── Android Client (ter referentie — niet gebruikt door web worker) ──────────
# Android Client ID (aangemaakt in Google Console → "Android" type)
# ANDROID_GOOGLE_CLIENT_ID=your_android_client_id_here.apps.googleusercontent.com
# Package name: nl.thepot.nexuscrm
# SHA-1 fingerprint: (zie keystore met: keytool -list -v -keystore release.keystore)

# ─── iOS Client (ter referentie — niet gebruikt door web worker) ──────────────
# iOS Client ID (aangemaakt in Google Console → "iOS" type)
# IOS_GOOGLE_CLIENT_ID=your_ios_client_id_here.apps.googleusercontent.com
# Bundle ID: nl.thepot.nexuscrm
# App Store ID: (optioneel)
